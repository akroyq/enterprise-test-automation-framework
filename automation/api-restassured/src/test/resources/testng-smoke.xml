<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Insurance Claims API Smoke Test Suite" verbose="1" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="com.qualityarchitect.core.reporting.ExtentTestListener"/>
        <listener class-name="com.qualityarchitect.core.retry.AnnotationTransformer"/>
    </listeners>
    <test name="API Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.qualityarchitect.api.tests.ClaimsApiTest"/>
        </classes>
    </test>
</suite>
