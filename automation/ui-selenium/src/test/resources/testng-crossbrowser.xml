<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Insurance Claims UI Cross-Browser Test Suite" verbose="1" parallel="tests" thread-count="3">
    <listeners>
        <listener class-name="com.qualityarchitect.core.reporting.ExtentTestListener"/>
        <listener class-name="com.qualityarchitect.core.retry.AnnotationTransformer"/>
    </listeners>

    <test name="Chrome Browser Execution">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.qualityarchitect.ui.tests.ClaimsUiTest"/>
        </classes>
    </test>

    <test name="Edge Browser Execution">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.qualityarchitect.ui.tests.ClaimsUiTest"/>
        </classes>
    </test>

    <test name="Firefox Browser Execution">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.qualityarchitect.ui.tests.ClaimsUiTest"/>
        </classes>
    </test>
</suite>
